# Speed Dreams dedicated server.
#
#   cp speed-dreams-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now speed-dreams-server
#
# One race per process, restarted by systemd. The server exits after the race
# rather than looping back to the lobby: between races the race engine unloads
# and reloads the track, physics and robot modules, all of which carry static
# state across that, and this port has already produced several bugs in exactly
# that territory. Restarting is free here and removes the whole class.
#
# Open UDP 28500 (the game) and TCP 28600 (the stats endpoint) inbound.

[Unit]
Description=Speed Dreams dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sdserver
Group=sdserver

# Where setup-linux-server.sh installed it, and the user directory it seeded.
Environment=HOME=/home/sdserver
WorkingDirectory=/home/sdserver/sdserver/games
ExecStart=/home/sdserver/sdserver/games/speed-dreams-2 -x -s netserver --minplayers 1

# A race ends and the process exits; come straight back up for the next one.
Restart=always
RestartSec=2

# The server needs no display, no sound device and no privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sdserver/.speed-dreams-2
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
